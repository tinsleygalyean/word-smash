# Word Smash — credentials template.
#
# Copy to `.env` (or run `pnpm env:init`) and fill in the key. `.env` is
# git-ignored; this template is committed and must never contain a real value.
#
# Only needed to upload releases to the Curious Reader CMS. Building, testing,
# previewing, and packaging the game need no credentials at all.
#
# Used by:  pnpm game:upload -- --live
# Docs:     docs/CONTENT_PIPELINE.md  ("The CMS token")

# Base URL of the Curious Reader CMS MCP server.
CR_CMS_SERVER_URL=https://curious-learning-parent.replit.app/mcp

# MCP API key, sent as `Authorization: Bearer <key>`.
# Ask the Curious Learning team. Paste it after the "=" with no quotes or
# spaces, then save. Never paste it into a chat, a commit, or a screenshot.
CR_MCP_API_KEY=

# Optional — overrides the engine URL template registered with the CMS.
# Leave commented unless the Curious Learning team tells you otherwise.
# CR_URL_TEMPLATE=https://wordsmash.curiouslearning.org/?cr_lang={lang}
